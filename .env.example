# Chave da API Last.fm (server-only — nunca use NEXT_PUBLIC_)
# Obtenha em: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here

# URL pública do site (metadata Open Graph / Twitter)
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for signing session JWT (min 32 chars — generate with: openssl rand -base64 32)
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars
